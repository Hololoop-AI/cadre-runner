[Unit]
Description=review-surface page server (Cadre)
Documentation=https://github.com/Hololoop-AI/cadre-runner/blob/true-prototype/docs/DIALOGUE-SETUP.md
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/review-surface
Environment=REVIEW_SURFACE_NO_OPEN=1
# A "Study" button on every annotation popup: it sends `study: <note>` at once, on
# the selected passage, and Cadre starts a study session beside the page without
# spending a round of the dialogue (runnerlib/surface.py, `_study_topic`).
Environment='REVIEW_SURFACE_ANNOTATION_ACTIONS=[{"id":"study","label":"Study","title":"Study this in a session beside the page; this dialogue keeps its round","prefix":"study: ","deliver":"now","fallback":"this passage"}]'
ExecStart=/usr/bin/node %h/Projects/review-surface/dist/cli.mjs server --port 4387
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
