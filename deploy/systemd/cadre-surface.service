[Unit]
Description=review-surface page server (Cadre)
Documentation=https://github.com/Hololoop-AI/cadre-runner/blob/true-prototype/docs/DIALOGUE-SETUP.md
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/review-surface
Environment=REVIEW_SURFACE_NO_OPEN=1
# A "Thread" button on every annotation popup: it sends `thread: <note>` at
# once, on the selected passage, and Cadre opens a side chat beside the page
# without spending a round of the dialogue. Keep it equal to runnerlib/surface.py
# ANNOTATION_ACTIONS, which `pipeline.py up` passes (tests/test_up.py checks).
Environment='REVIEW_SURFACE_ANNOTATION_ACTIONS=[{"id":"thread","label":"Thread","title":"Talk about this in a side chat; ask it to teach you, or to send a note to the page. This dialogue keeps its round","prefix":"thread: ","deliver":"now","fallback":"this passage"}]'
ExecStart=/usr/bin/node %h/Projects/review-surface/dist/cli.mjs server --port 4387
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
