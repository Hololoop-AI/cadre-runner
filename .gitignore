# Local-only: holds machine-specific paths (no secrets, but per-machine).
# Copy from config.example.toml on each host.
config.toml
__pycache__/
*.pyc

# The local instance config. Written by deploy/install.sh per machine: it
# carries this host s paths, so shipping one person s copy hands every other
# machine the wrong skills_source and data_dir.
config.local.toml
